# Generated by XcodeGen — regenerate with `make bootstrap`
Pantopus.xcodeproj/

# Xcode
build/
DerivedData/
*.xcuserdatad
*.xcuserstate
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
.swiftpm/

# Swift Package Manager
.build/
Packages/
# Workspace-local SPM clones. CI resolves packages here (ios-ci.yml IOS_SPM_PATH), and so
# does any local `xcodebuild -clonedSourcePackagesDirPath SourcePackages`, which otherwise
# leaves ~12k untracked third-party files sitting in `git status`.
SourcePackages/
# Carve out feature folders — `Packages/` above matches SwiftPM source
# trees; these per-feature `Packages/` directories are real source code.
!Pantopus/Features/Homes/Packages/
!Pantopus/Features/Scheduling/Routing/Stubs/Packages/
Package.pins
Package.resolved
# Resolved dependency clones/checkouts/artifacts. `xcodebuild
# -clonedSourcePackagesDirPath` and Xcode both land these here; it reaches
# multiple GB, so an unguarded `git add -A` would stage the whole cache.
SourcePackages/

# CocoaPods — not used, but just in case
Pods/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output
fastlane/.env*
!fastlane/.env.example

# Env
.env
.env.*
!.env.example

# Secrets materialized from .env at build time
Config/Secrets.xcconfig

# Bundler
vendor/bundle

# macOS
.DS_Store
